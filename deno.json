{
  "name": "@whaaaley/looks-good",
  "version": "0.5.0",
  "license": "MIT",
  "links": [
    "../common",
    "../git-going"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./eslint-rules": "./src/eslint-rules.ts"
  },
  "publish": {
    "exclude": [
      "**/*.test.ts",
      ".claude/",
      "eslint.config.js",
      ".oxlintrc.json",
      "release-please-config.json",
      ".release-please-manifest.json"
    ]
  },
  "compilerOptions": {
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "exclude": [
    ".claude/",
    "deleted/",
    "notes/"
  ],
  "tasks": {
    "check": "deno check --unstable-tsgo src/",
    "lint": "deno task lint:deno && deno task lint:oxlint && deno task lint:eslint",
    "lint:deno": "deno lint",
    "lint:oxlint": "deno run -A npm:oxlint@1.78.0 src",
    "lint:eslint": "deno run -A npm:eslint src eslint.config.js",
    "lint:fix": "deno run -A npm:eslint src eslint.config.js --fix",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test -A",
    "test:coverage": "deno test -A --coverage=coverage",
    "coverage": "deno coverage coverage"
  },
  "lint": {
    "rules": {
      "include": [
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-explicit-any",
        "no-non-null-assertion"
      ]
    }
  },
  "fmt": {
    "lineWidth": 240,
    "semiColons": false,
    "singleQuote": true,
    "exclude": [
      "*.md",
      "**/*.md"
    ]
  },
  "imports": {
    "@eslint/js": "npm:@eslint/js@^10.0.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@types/eslint": "npm:@types/eslint@^9.6.1",
    "@typescript-eslint/parser": "npm:@typescript-eslint/parser@^8.67.0",
    "@whaaaley/common": "jsr:@whaaaley/common@0",
    "@whaaaley/git-going": "jsr:@whaaaley/git-going@0",
    "eslint": "npm:eslint@^10.8.1",
    "eslint-plugin-import-x": "npm:eslint-plugin-import-x@^4.17.1",
    "globals": "npm:globals@^17.11.0",
    "mdast-util-from-markdown": "npm:mdast-util-from-markdown@^2.0.3",
    "minimatch": "npm:minimatch@^10.2.6",
    "nlcst-to-string": "npm:nlcst-to-string@^4.0.0",
    "parse-english": "npm:parse-english@^7.0.0",
    "typescript-eslint": "npm:typescript-eslint@^8.67.0",
    "estree": "npm:@types/estree@^1.0.9",
    "mdast": "npm:@types/mdast@^4.0.4",
    "nlcst": "npm:@types/nlcst@^2.0.3"
  }
}
